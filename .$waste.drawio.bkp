        <mxCell id="tr_start" value="Khởi động" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#0F172A;strokeWidth=2;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="sm_start" target="st_idle" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 2: IDLE -> NEAR FULL -->
        <mxCell id="tr_idle_near" value="≥ 70%" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#854D0E;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_idle" target="st_near_full" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 3: NEAR FULL -> OVERFULL -->
        <mxCell id="tr_near_over" value="≥ 85%" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_near_full" target="st_overfull" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 4: OVERFULL -> RESERVED -->
