          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 5: RESERVED -> COLLECTING -->
        <mxCell id="tr_res_coll" value="Vehicle ≤ 15m" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#9333EA;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#7E22CE;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_reserved" target="st_collecting" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 6: COLLECTING -> COLLECTED -->
        <mxCell id="tr_coll_collected" value="RPC OK" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#15803D;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#166534;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_collecting" target="st_collected" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1432" y="340" />
              <mxPoint x="832" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- TR 7: COLLECTED -> IDLE (Loopback to Main Flow Start) -->
        <mxCell id="tr_collected_idle" value="Level → 0% | LID_CLOSE" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#15803D;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_collected" target="st_idle" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="480" />
              <mxPoint x="400" y="480" />
              <mxPoint x="400" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- TR 8: NEAR FULL -> IDLE (Dọn rác sớm) -->
        <mxCell id="tr_near_idle" value="&lt; 70% (Dọn sớm)" style="endArrow=block;endFill=1;endSize=5;dashed=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#166534;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_near_full" target="st_idle" edge="1">
          <mxGeometry relative="1" as="geometry">
