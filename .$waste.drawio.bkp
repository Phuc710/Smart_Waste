            </Array>
          </mxGeometry>
        </mxCell>

        <!-- TR 9: IDLE -> OFFLINE -->
        <mxCell id="tr_idle_offline" value="Liveness &gt; 15s" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#64748B;strokeWidth=2;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_idle" target="st_offline" edge="1">
