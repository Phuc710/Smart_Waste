        <!-- TR 10: OFFLINE -> IDLE -->
        <mxCell id="tr_offline_idle" value="Auto reconnect 3s" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#15803D;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_offline" target="st_idle" edge="1">
