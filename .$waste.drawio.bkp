        </mxCell>

        <!-- ==================== MAIN FLOW NODES (ROW 1: y=140, height=140, width=225) ==================== -->

        <!-- 1. IDLE / NORMAL -->
        <mxCell id="st_idle" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#15803D;&quot;&gt;IDLE&lt;/b&gt;&lt;span style=&quot;background:#DCFCE7;color:#166534;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;NORMAL&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Mức rác: 0% – 69%&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Nắp: CLOSED | Mode: AUTO&lt;br&gt;• Quét người &amp;le; 30cm &amp;rarr; Mở 5s&lt;br&gt;• Telemetry chu kỳ: 1000ms&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="120" y="140" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 2. NEAR FULL -->
        <mxCell id="st_near_full" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#A16207;&quot;&gt;NEAR FULL&lt;/b&gt;&lt;span style=&quot;background:#FEF9C3;color:#854D0E;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;WARNING&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Mức rác: 70% – 84%&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Chuẩn bị lập kế hoạch gom&lt;br&gt;• Badge VÀNG trên Map/Web&lt;br&gt;• Nắp: CLOSED | Mode: AUTO&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="420" y="140" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 3. OVERFULL -->
        <mxCell id="st_overfull" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#B91C1C;&quot;&gt;OVERFULL&lt;/b&gt;&lt;span style=&quot;background:#FEE2E2;color:#991B1B;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;CRITICAL 🚨&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Mức rác: &amp;ge; 85%&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Socket: binOverfullAlert&lt;br&gt;• Tìm xe gom rảnh gần nhất&lt;br&gt;• Bật LED cảnh báo khẩn cấp&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="720" y="140" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 4. RESERVED -->
        <mxCell id="st_reserved" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1D4ED8;&quot;&gt;RESERVED&lt;/b&gt;&lt;span style=&quot;background:#DBEAFE;color:#1E40AF;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;ASSIGNED&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;DispatchJob Locked&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Khóa thùng trong lộ trình OSRM&lt;br&gt;• Tài xế: ACCEPTED / IN_PROGRESS&lt;br&gt;• Hiển thị Stop Point trên App&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1020" y="140" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 5. COLLECTING -->
        <mxCell id="st_collecting" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#7E22CE;&quot;&gt;COLLECTING&lt;/b&gt;&lt;span style=&quot;background:#F3E8FF;color:#6B21A8;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;ACTIVE 🚛&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Xe đến &amp;le; 15m&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Lệnh: LID_OPEN từ xa qua App&lt;br&gt;• Mở nắp 90&amp;deg;, trút rác vào xe&lt;br&gt;• Collection in progress&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1320" y="140" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- ==================== AUXILIARY / LOOPBACK NODES (ROW 2: y=410, height=140, width=225) ==================== -->

        <!-- 7. OFFLINE (Placed Left) -->
        <mxCell id="st_offline" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#334155;&quot;&gt;OFFLINE&lt;/b&gt;&lt;span style=&quot;background:#E2E8F0;color:#1E293B;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;OFFLINE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Liveness Timeout &gt; 15s&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Đánh dấu: is_online = false&lt;br&gt;• Mở nắp cục bộ vẫn hoạt động&lt;br&gt;• Auto reconnect 3s retry loop&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="120" y="410" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 6. COLLECTED (Placed Middle Loopback) -->
        <mxCell id="st_collected" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#166534;&quot;&gt;COLLECTED&lt;/b&gt;&lt;span style=&quot;background:#DCFCE7;color:#14532D;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;COMPLETED&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;RPC: rpc_collect_bin()&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Mức rác đặt lại: 0%&lt;br&gt;• Đóng nắp: LID_CLOSE (0&amp;deg;)&lt;br&gt;• Release JobItem &amp;rarr; Đóng ca&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="720" y="410" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 8. PAUSED / MAINTENANCE (Placed Bottom) -->
        <mxCell id="st_paused" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#C2410C;&quot;&gt;PAUSED&lt;/b&gt;&lt;span style=&quot;background:#FFEDD5;color:#9A3412;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;MAINTENANCE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;Sự cố / Admin PAUSE&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Cờ: collection_paused = true&lt;br&gt;• Tạm dừng tiếp nhận ca gom&lt;br&gt;• Báo cáo hỏng nắp / cảm biến&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1020" y="410" width="225" height="140" as="geometry" />
        </mxCell>

        <!-- 9. OTA UPDATING (Placed Right) -->
        <mxCell id="st_ota" value="&lt;div style=&quot;padding:2px;&quot;&gt;&lt;div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;&quot;&gt;&lt;b style=&quot;font-size:13px;color:#0E7490;&quot;&gt;OTA UPDATING&lt;/b&gt;&lt;span style=&quot;background:#CFFAFE;color:#155E75;font-size:9px;font-weight:bold;padding:1px 5px;border-radius:3px;&quot;&gt;UPDATING 🚀&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:600;color:#0F172A;margin-bottom:3px;&quot;&gt;wastebin/{id}/ota&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#475569;line-height:1.35;&quot;&gt;• Tải HTTPS Signed URL 1h&lt;br&gt;• Check SHA-256 &amp; Flash app1&lt;br&gt;• Dual-Partition Bootloader&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;align=left;spacingLeft=6;fontFamily=Inter,Arial,sans-serif;" parent="1" vertex="1">
          <mxGeometry x="1320" y="410" width="225" height="140" as="geometry" />
        </mxCell>

