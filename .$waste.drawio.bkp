        <!-- TR 11: COLLECTED -> PAUSED / MAINTENANCE -->
        <mxCell id="tr_coll_paused" value="Fault / Admin PAUSE" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#EA580C;strokeWidth=2;fontSize=11;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_collected" target="st_paused" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TR 12: PAUSED -> IDLE (Resume) -->
        <mxCell id="tr_paused_idle" value="Technician fixed / Admin RESUME" style="endArrow=block;endFill=1;endSize=5;html=1;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#15803D;labelBackgroundColor=#FFFFFF;rounded=1;fontFamily=Inter,Arial,sans-serif;" parent="1" source="st_paused" target="st_idle" edge="1">
