{
  "name": "smartwaste-web-admin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --prefix backend start",
    "server": "npm --prefix backend start",
    "server:dev": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "client:build": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "aedes": "^0.47.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  }
}
