# Khóa đặc quyền chỉ dùng tại Node.js. Tuyệt đối không đưa vào public/ hoặc ứng dụng Android.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Key dùng trong trình duyệt. Giới hạn theo HTTP referrer và Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=AIza_your_browser_key_here

# Key chỉ dùng tại Node.js cho Routes API (nếu dùng tính tuyến đường).
# Khi phát triển có thể tạm dùng cùng key với browser key.
GOOGLE_ROUTES_SERVER_KEY=AIza_your_server_key_here

# Tùy chọn: Map ID tạo trong Google Maps Platform > Map Management.
GOOGLE_MAP_ID=
