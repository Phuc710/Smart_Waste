<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_notif_card_clean"
    android:clickable="true"
    android:elevation="0.5dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Step number badge (01, 02, 03) -->
    <LinearLayout
        android:id="@+id/llPointIndexContainer"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_icon_circle_green"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointIndexNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01"
            android:textColor="#16A34A"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivPointBinIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Thùng"
            android:src="@drawable/ic_trash_bin_red"
            app:tint="#16A34A" />
    </LinearLayout>

    <!-- Point Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointBinCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="BIN_HCM_01"
            android:textColor="@color/profile_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPointBinAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chợ Bến Thành, Q1"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Right Side: Fill level & Distance -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointFillPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="88%"
            android:textColor="#E53935"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPointFillStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_badge_pill_red"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="Đầy"
            android:textColor="#E53935"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPointDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 1.4 km"
                android:textColor="@color/profile_text_tertiary"
                android:textSize="11.5sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="3dp"
                android:contentDescription="Mũi tên"
                android:src="@drawable/ic_chevron_right_gray" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
