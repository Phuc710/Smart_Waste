<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJobAcceptedRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_profile"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Badge Row: 🟢 ĐÃ NHẬN CA + Dispatcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Đã nhận"
                android:src="@drawable/ic_check_circle_badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="ĐÃ NHẬN CA"
                android:textColor="@color/profile_green_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Người giao"
            android:src="@drawable/ic_person"
            app:tint="@color/profile_text_secondary" />

        <TextView
            android:id="@+id/tvAcceptedDispatcherName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Admin điều phối"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Job ID -->
    <TextView
        android:id="@+id/tvAcceptedJobCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="#JOB_1723801234"
        android:textColor="@color/profile_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 3 Metrics Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_item_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:weightSum="3">

        <!-- Metric 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Điểm"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/profile_green_primary" />

            <TextView
                android:id="@+id/tvAcceptedStops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="3 điểm gom"
                android:textColor="@color/profile_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/profile_divider" />

        <!-- Metric 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Quãng đường"
                android:src="@drawable/ic_route_nodes"
                app:tint="@color/profile_green_primary" />

            <TextView
                android:id="@+id/tvAcceptedDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.8 km"
                android:textColor="@color/profile_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="@color/profile_divider" />

        <!-- Metric 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="Thời gian"
                android:src="@drawable/ic_clock_green"
                app:tint="@color/profile_green_primary" />

            <TextView
                android:id="@+id/tvAcceptedDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="~25 phút"
                android:textColor="@color/profile_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Route summary: Tuyến: 01 → 02 → 03 -->
    <TextView
        android:id="@+id/tvAcceptedRouteSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🛣 Tuyến lộ trình: 01 → 02 → 03"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12.5sp" />

    <!-- Action Button: [ Bắt đầu ca / Xem chi tiết ca ] -->
    <Button
        android:id="@+id/btnStartExecution"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_primary_green"
        android:drawableStart="@drawable/ic_play_white"
        android:paddingHorizontal="20dp"
        android:text="Bắt đầu thực hiện ca"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
