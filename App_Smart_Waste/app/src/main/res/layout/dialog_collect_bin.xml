<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#CBD5E1" />

    <!-- Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCollectDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác nhận thu gom"
                android:textColor="@color/profile_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCollectDialogBinCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Điểm thu gom: BIN_HCM_04 • Phố đi bộ Nguyễn Huệ"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseCollectDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_gray" />
    </LinearLayout>

    <!-- Camera / Photo Preview Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_item_field"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCollectPhotoPreview"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_secondary_gray"
            android:contentDescription="Ảnh minh chứng"
            android:scaleType="centerCrop"
            android:src="@drawable/login_bg" />

        <Button
            android:id="@+id/btnCaptureCollectPhoto"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_secondary_gray"
            android:drawableStart="@drawable/ic_camera_white"
            android:drawablePadding="6dp"
            android:drawableTint="@color/profile_green_primary"
            android:text="Chụp ảnh minh chứng"
            android:textAllCaps="false"
            android:textColor="@color/profile_green_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/tvCollectPhotoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ Đã chụp ảnh hiện trường (1.2 MB)"
            android:textColor="#16A34A"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Note Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCollectNote"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Ghi chú thực địa (tùy chọn)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCollectNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rác đầy tràn miệng thùng, đã dọn sạch xung quanh"
            android:textColor="@color/profile_text_primary"
            android:textSize="13.5sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCollect"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_gray"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnConfirmCollect"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_btn_accept_green"
            android:text="Xác nhận"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
