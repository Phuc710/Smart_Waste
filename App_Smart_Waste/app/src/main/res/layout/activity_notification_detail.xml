<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutNotifDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- 1. Unified AppHeader -->
    <com.example.app_smart_waste.ui.common.AppHeaderView
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_divider" />

    <!-- 2. Scrollable Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingTop="14dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_in_app_banner_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- A. Top Section: Large Icon + Title + Timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/containerDetailIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_banner_icon_red">

                    <ImageView
                        android:id="@+id/ivDetailIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Icon thông báo"
                        android:src="@drawable/ic_banner_alert_red" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/app_text_primary"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        tools:text="Cảnh báo thùng quá tải (90%)" />

                    <TextView
                        android:id="@+id/tvDetailTimestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="12.5sp"
                        tools:text="10:31 • 20/05/2025" />
                </LinearLayout>
            </LinearLayout>

            <!-- B. Section: Nội dung -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nội dung"
                android:textColor="@color/app_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/app_text_secondary"
                android:textSize="13.5sp"
                tools:text="Thùng rác Bến Bạch Đằng, Quận 1 đang vượt mức cho phép (90%). Vui lòng đến thu gom trong thời gian sớm nhất." />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="18dp"
                android:background="@color/app_divider" />

            <!-- C. Section: Thông tin chi tiết (Metadata Table) -->
            <TextView
                android:id="@+id/tvDetailMetaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin thùng rác"
                android:textColor="@color/app_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutMetaContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/rowMeta1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetaLabel1"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Mã thùng:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMetaValue1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="BIN-015" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/rowMeta2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetaLabel2"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Vị trí:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMetaValue2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="Bến Bạch Đằng, Quận 1" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/rowMeta3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetaLabel3"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Mức đầy:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMetaValue3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/app_danger"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="90% • 240 L" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:id="@+id/rowMeta4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMetaLabel4"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Cập nhật lúc:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMetaValue4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/app_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="10:30 • 20/05/2025" />
                </LinearLayout>
            </LinearLayout>

            <!-- D. Main Action Button: [ 📍 Mở bản đồ ] / [ 📋 Xem nhiệm vụ ] -->
            <FrameLayout
                android:id="@+id/btnDetailAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_action_solid_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivDetailBtnIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Icon hành động"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvDetailBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mở bản đồ"
                        android:textColor="@color/white"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- E. Map Preview Card (Visible for Bin and Route alerts) -->
            <FrameLayout
                android:id="@+id/cardMapPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_in_app_banner_card"
                android:clipToPadding="true">

                <!-- Vector Map Illustration -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Bản đồ minh họa"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_map_preview" />

                <!-- Red Location Pin Centered on Map -->
                <ImageView
                    android:id="@+id/ivCenterPin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ghim định vị"
                    android:src="@drawable/ic_pin_red" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
