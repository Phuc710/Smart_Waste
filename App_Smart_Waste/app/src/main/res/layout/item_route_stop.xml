<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Stop Number Circle (1, 2, 3, 4) -->
    <TextView
        android:id="@+id/tvStopNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_stop_num_green"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="1" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Thùng 1 – BIN-023" />

        <TextView
            android:id="@+id/tvStopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6B7280"
            android:textSize="12.5sp"
            tools:text="Đường Nguyễn Văn Linh, Quận 7" />
    </LinearLayout>

    <!-- Waste Level % -->
    <TextView
        android:id="@+id/tvStopLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="#EF4444"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="87%" />

    <!-- Status Badge + Time Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStopStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_collected"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#16A34A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Đã thu gom" />

        <TextView
            android:id="@+id/tvStopTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7280"
            android:textSize="11sp"
            tools:text="08:30" />
    </LinearLayout>

    <!-- Chevron arrow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="#9CA3AF"
        android:textSize="18sp" />

</LinearLayout>
