<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Main Fragment Container -->
    <FrameLayout
        android:id="@+id/navHostContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top divider line -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer" />

    <!-- 4-Item Equal-Weight Bottom Navigation Container (Trang chủ | Nhiệm vụ | Bản đồ | Cá nhân) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/bottomNavRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- 1. Trang chủ -->
            <LinearLayout
                android:id="@+id/navItemHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Trang chủ"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#16A34A" />

                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Trang chủ"
                    android:textColor="#16A34A"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Nhiệm vụ (With Realtime Badge ③) -->
            <LinearLayout
                android:id="@+id/navItemJobs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/navIconJobs"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Nhiệm vụ"
                        android:src="@drawable/ic_nav_jobs"
                        app:tint="#9CA3AF" />

                    <!-- Red Realtime Alert Badge with White Border -->
                    <TextView
                        android:id="@+id/navBadgeJobs"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:minWidth="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="-8dp"
                        android:layout_marginTop="-4dp"
                        android:background="@drawable/bg_badge_count_red"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="1" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelJobs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Nhiệm vụ"
                    android:textColor="#9CA3AF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 3. Bản đồ -->
            <LinearLayout
                android:id="@+id/navItemMap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconMap"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Bản đồ"
                    android:src="@drawable/ic_nav_map"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Bản đồ"
                    android:textColor="#9CA3AF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 4. Cá nhân -->
            <LinearLayout
                android:id="@+id/navItemProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Cá nhân"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/navLabelProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Cá nhân"
                    android:textColor="#9CA3AF"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>