<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_padding">

            <!-- 1. Shared Unified AppHeader (Scrolls naturally with page) -->
            <com.example.app_smart_waste.ui.common.AppHeaderView
                android:id="@+id/appHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_horizontal_padding">

                <!-- 2. VEHICLE CARD -->
                <LinearLayout
                    android:id="@+id/vehicleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_clean"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                <!-- Truck Illustration -->
                <ImageView
                    android:id="@+id/imgTruck"
                    android:layout_width="92dp"
                    android:layout_height="62dp"
                    android:contentDescription="Xe thu gom"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_truck" />

                <!-- Truck Plate & Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xe đang sử dụng"
                        android:textColor="#6B7280"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvTruckPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="51A-12345"
                        android:textColor="#111827"
                        android:textSize="17.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fuel Information -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Nhiên liệu"
                            android:src="@drawable/ic_fuel_pump" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Nhiên liệu"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFuelPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="70%"
                        android:textColor="#111827"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressFuel"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="80dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="70"
                        android:progressDrawable="@drawable/bg_fuel_progress" />
                </LinearLayout>
            </LinearLayout>

            <!-- ────────── 3. OVERVIEW SECTION (4 CARDS) ────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng quan hôm nay"
                    android:textColor="#111827"
                    android:textSize="18.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="Xem chi tiết  ›"
                    android:textColor="#6B7280"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 4 Equal Stat Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- Card 1: Tổng nhiệm vụ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Tổng nhiệm vụ"
                        android:src="@drawable/ic_stat_clipboard" />

                    <TextView
                        android:id="@+id/tvStatTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="10"
                        android:textColor="#111827"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Tổng nhiệm vụ"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 2: Cần thu gom (> 85%) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Cần thu gom"
                        android:src="@drawable/ic_stat_trash" />

                    <TextView
                        android:id="@+id/tvStatPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3"
                        android:textColor="#111827"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="Cần thu gom"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="(&gt; 85%)"
                        android:textColor="#EF4444"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card 3: Đang thực hiện -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Đang thực hiện"
                        android:src="@drawable/ic_stat_clock" />

                    <TextView
                        android:id="@+id/tvStatProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1"
                        android:textColor="#111827"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Đang thực hiện"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 4: Hoàn thành -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="126dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Hoàn thành"
                        android:src="@drawable/ic_stat_check" />

                    <TextView
                        android:id="@+id/tvStatDone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="6"
                        android:textColor="#111827"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Hoàn thành"
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ────────── 4. RECENT TASKS SECTION ────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhiệm vụ gần đây"
                    android:textColor="#111827"
                    android:textSize="18.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewAllJobs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="Xem tất cả  ›"
                    android:textColor="#6B7280"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Single Large Container for Recent Tasks -->
            <LinearLayout
                android:id="@+id/containerRecentJobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/jobRow1"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icJob1Indicator"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Status indicator"
                        android:src="@drawable/ic_indicator_red" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvJob1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIN-023"
                            android:textColor="#111827"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvJob1Location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đường Nguyễn Văn Linh, Quận 7"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJob1Level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="87%"
                        android:textColor="#EF4444"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJob1Distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="2.4 km"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="›"
                        android:textColor="#9CA3AF"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="#F3F4F6" />

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/jobRow2"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icJob2Indicator"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Status indicator"
                        android:src="@drawable/ic_indicator_red" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvJob2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIN-041"
                            android:textColor="#111827"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvJob2Location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đường Trần Xuân Soạn, Quận 7"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJob2Level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92%"
                        android:textColor="#EF4444"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJob2Distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="3.1 km"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="›"
                        android:textColor="#9CA3AF"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="#F3F4F6" />

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/jobRow3"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icJob3Indicator"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Status indicator"
                        android:src="@drawable/ic_indicator_yellow" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvJob3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIN-055"
                            android:textColor="#111827"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvJob3Location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đường Lê Văn Lương, Nhà Bè"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvJob3Level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="81%"
                        android:textColor="#F59E0B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJob3Distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="4.5 km"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="›"
                        android:textColor="#9CA3AF"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="#F3F4F6" />

                <!-- Row 4 -->
                <LinearLayout
                    android:id="@+id/jobRow4"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icJob4Indicator"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Status indicator"
                        android:src="@drawable/ic_indicator_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvJob4Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIN-012"
                            android:textColor="#111827"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvJob4Location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đường Phạm Hữu Lầu, Quận 7"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvJob4Level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã hoàn thành"
                            android:textColor="#16A34A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvJob4Distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="08:45"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="›"
                        android:textColor="#9CA3AF"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ────────── 5. TODAY'S ROUTE SECTION ────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tuyến đường hôm nay"
                    android:textColor="#111827"
                    android:textSize="18.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="Xem tuyến  ›"
                    android:textColor="#6B7280"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Large Route Card with Map Preview & Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="horizontal"
                android:padding="14dp">

                <!-- Left Map Preview Box -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/mapPreviewContainer"
                    android:layout_width="135dp"
                    android:layout_height="148dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/mapPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Bản đồ tuyến đường"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_map_preview" />
                </androidx.cardview.widget.CardView>

                <!-- Right Route Details & CTA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Point count -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Điểm thu gom"
                            android:src="@drawable/ic_pin_green" />

                        <TextView
                            android:id="@+id/tvRoutePoints"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="4 điểm thu gom"
                            android:textColor="#1F2937"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Distance -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Khoảng cách"
                            android:src="@drawable/ic_road_green" />

                        <TextView
                            android:id="@+id/tvRouteDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="12.7 km"
                            android:textColor="#1F2937"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Duration -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Thời gian"
                            android:src="@drawable/ic_clock_green" />

                        <TextView
                            android:id="@+id/tvRouteDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="32 phút"
                            android:textColor="#1F2937"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Start Route CTA Button -->
                    <LinearLayout
                        android:id="@+id/btnStartRouteHome"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_btn_start_route"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="Bắt đầu"
                            android:src="@drawable/ic_nav_send" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Bắt đầu tuyến"
                            android:textColor="#16A34A"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
