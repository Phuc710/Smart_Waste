<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#CBD5E1" />

    <!-- Header: Title & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thông tin cá nhân"
            android:textColor="@color/profile_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_gray" />
    </LinearLayout>

    <!-- Profile Hero inside Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_item_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/dialogAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_work_info"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/img_avatar_worker"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/profile_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Người dùng" />

            <TextView
                android:id="@+id/dialogRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/profile_green_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Nhân viên thu gom" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="● Đang trực tuyến / Sẵn sàng"
                android:textColor="#16A34A"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Field Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- Field 1: Mã nhân viên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_dialog_item_field"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã nhân viên"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dialogStaffCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="NV-1024" />
        </LinearLayout>

        <!-- Field 2: Tên đăng nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_dialog_item_field"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên đăng nhập hệ thống"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dialogUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="driver01" />
        </LinearLayout>

        <!-- Field 3: Đội vận hành -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_dialog_item_field"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn vị phụ trách"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                tools:text="Đội xe thu gom thông minh" />
        </LinearLayout>

        <!-- Field 4: Giấy phép -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_item_field"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giấy phép điều khiển"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                tools:text="Hạng C (Xe tải chuyên dụng > 3.5T)" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Button -->
    <Button
        android:id="@+id/btnDonePersonalInfo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_primary_green"
        android:text="Đóng"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
