<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- 1. Shared Unified AppHeader -->
    <com.example.app_smart_waste.ui.common.AppHeaderView
        android:id="@+id/incidentsAppHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 2. Filter Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_horizontal_padding"
        android:paddingVertical="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutIncidentFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipIncidentFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_all_active"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Tất cả"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipIncidentFilterNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_filter_inactive"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Mới gửi"
                android:textColor="@color/app_text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipIncidentFilterInReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_filter_inactive"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Đang xử lý"
                android:textColor="@color/app_text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/chipIncidentFilterResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_filter_inactive"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Đã giải quyết"
                android:textColor="@color/app_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. Swipe Refresh & RecyclerView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/incidentSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIncidentsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_horizontal_padding"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_incident_card" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyIncidents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_card_profile"
                android:elevation="1dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Trống"
                    android:src="@drawable/ic_check_circle_green"
                    app:tint="@color/profile_text_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chưa có báo cáo sự cố nào"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Các sự cố về thùng rác, nắp thùng hay cảm biến bạn đã báo cáo sẽ xuất hiện tại đây."
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 4. Bottom Action Bar: [ + Gửi báo cáo sự cố mới ] -->
    <LinearLayout
        android:id="@+id/layoutIncidentBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateNewIncident"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_primary_green"
            android:text="+ Báo cáo sự cố mới"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
