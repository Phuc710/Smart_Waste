<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- Header: Lệnh điều chuyển + Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Lệnh điều chuyển"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseRerouteSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="6dp"
                android:src="@drawable/ic_close_gray" />
        </RelativeLayout>

        <!-- Tuyến mới cho job -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tuyến mới cho job:"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRerouteJobId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="JOB_1723801234"
            android:textColor="#0F172A"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <!-- Lý do điều chuyển -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Lý do điều chuyển:"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRerouteReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_clean"
            android:padding="12dp"
            android:text="Thùng rác quá tải trên tuyến, điều hướng xe gom tối ưu."
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <!-- Áp dụng cho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Áp dụng cho:"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgRerouteScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbRerouteAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:checked="true"
                android:text="Tất cả điểm còn lại"
                android:textColor="#0F172A"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbRerouteSelect"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Chọn điểm cụ thể"
                android:textColor="#0F172A"
                android:textSize="13.5sp" />
        </RadioGroup>

        <!-- Action Buttons: [ Hủy ] | [ Áp dụng ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelReroute"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary_gray"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyReroute"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_primary_green"
                android:text="Áp dụng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
