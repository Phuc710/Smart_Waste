<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/navy_950" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Báo cáo sự cố thùng rác"
            android:textColor="@color/navy_950"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại sự cố gặp phải"
                android:textColor="@color/navy_950"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgIncidentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rbLidBroken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🔧 Nắp thùng bị hỏng / kẹt cơ học"
                    android:textColor="@color/navy_900"
                    android:textSize="13.5sp" />

                <RadioButton
                    android:id="@+id/rbSensorFault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡 Cảm biến báo sai mức rác"
                    android:textColor="@color/navy_900"
                    android:textSize="13.5sp" />

                <RadioButton
                    android:id="@+id/rbOverflow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Rác quá tải tràn ra ngoài"
                    android:textColor="@color/navy_900"
                    android:textSize="13.5sp" />

                <RadioButton
                    android:id="@+id/rbBlocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚧 Đường bị chặn, không thể tiếp cận"
                    android:textColor="@color/navy_900"
                    android:textSize="13.5sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mô tả chi tiết"
                android:textColor="@color/navy_950"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etIncidentDesc"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="Nhập thông tin mô tả sự cố để Admin xử lý..."
                android:padding="12dp"
                android:textColor="@color/navy_900"
                android:textColorHint="@color/navy_400"
                android:textSize="13.5sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Submit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitIncident"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_primary"
            android:text="Gửi Báo Cáo Sự Cố"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
