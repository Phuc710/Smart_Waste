<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_stat_circle_blue"
        android:backgroundTint="#FEE2E2">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Đăng xuất"
            android:src="@drawable/ic_logout_red" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Kết thúc ca làm việc?"
        android:textColor="@color/profile_text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Hệ thống sẽ đồng bộ toàn bộ lộ trình và điểm thu gom trước khi đăng xuất tài khoản."
        android:textColor="@color/profile_text_secondary"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelLogout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_gray"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/profile_text_primary"
            android:textSize="14.5sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnConfirmLogout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary_green"
            android:backgroundTint="@color/profile_danger"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
