<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#CBD5E1" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cảnh Báo Thùng Quá Tải"
                android:textColor="#DC2626"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ESP32 Telemetry MQTT: Mức rác vượt ngưỡng &gt; 85%"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseAlertDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_gray" />
    </LinearLayout>

    <!-- Bin Card Detail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dialog_item_field"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAlertBinName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thùng thông minh #BIN-002"
            android:textColor="@color/profile_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertBinLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 1 Công Xã Paris, Phường Bến Nghé, Quận 1"
            android:textColor="@color/profile_text_secondary"
            android:textSize="13sp" />

        <!-- Fill level progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mức rác hiện tại:"
                android:textColor="@color/profile_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlertLevelPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="92%"
                android:textColor="#DC2626"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbAlertFillLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="92"
            android:progressDrawable="@drawable/bg_btn_primary_green"
            android:progressTint="#DC2626" />

        <!-- Status chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlertLidState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_badge_pill"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Nắp: ĐÓNG (AUTO)"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAlertDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_role_badge_pill"
                android:backgroundTint="#FEF3C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Ước tính ~350m từ vị trí của bạn"
                android:textColor="#B45309"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewOnMap"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_gray"
            android:text="🗺️ Xem bản đồ"
            android:textAllCaps="false"
            android:textColor="@color/profile_green_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSelfPickAlertBin"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn_primary_green"
            android:text="🚛 Tự nhận thu gom"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
