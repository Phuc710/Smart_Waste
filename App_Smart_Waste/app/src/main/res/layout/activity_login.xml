<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <!-- 0. Subtle Eco Leaves Background Theme -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg" />

    <!-- 1. Keyboard & Scroll Aware Container -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <!-- 1. Shared Unified AppHeader (Consistent Status Bar Inset & Settings Icon) -->
            <com.example.app_smart_waste.ui.common.AppHeaderView
                android:id="@+id/appHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. Centered Body Container: Hero Branding + Elevated Login Form Card -->
            <LinearLayout
                android:id="@+id/centerBodyContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/bottomInfoCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appHeader"
                app:layout_constraintVertical_bias="0.45">

                <!-- Hero Branding Section -->
                <LinearLayout
                    android:id="@+id/topBrandingSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- 3D Eco Truck Brand Hero Image -->
                    <ImageView
                        android:id="@+id/ivHeroLogo"
                        android:layout_width="250dp"
                        android:layout_height="130dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/app_logo" />

                    <!-- Brand Title: Smart (Navy) + Waste (Emerald) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:text="Smart"
                            android:textColor="@color/navy_950"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:text="Waste"
                            android:textColor="@color/primary_500"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Subtitle: Smart Collection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Smart Collection"
                        android:textColor="@color/navy_500"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <!-- Elevated Login Form Card -->
                <LinearLayout
                    android:id="@+id/loginCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đăng nhập tài khoản"
                        android:textColor="@color/navy_950"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Field 1: Tên đăng nhập -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp"
                        android:text="Tên đăng nhập"
                        android:textColor="@color/navy_800"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerUsername"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field_selector"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_badge_soft">

                            <ImageView
                                android:id="@+id/ivUsernameIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_person"
                                app:tint="@color/primary_500" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="Tên đăng nhập"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="yes"
                            android:inputType="text"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/navy_900"
                            android:textColorHint="@color/navy_400"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Field 2: Mật khẩu -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:text="Mật khẩu"
                        android:textColor="@color/navy_800"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field_selector"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_badge_soft">

                            <ImageView
                                android:id="@+id/ivPasswordIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/primary_500" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="•••••••••"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/navy_900"
                            android:textColorHint="@color/navy_400"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Hiển thị hoặc ẩn mật khẩu"
                            android:padding="8dp"
                            android:src="@drawable/ic_eye_off"
                            app:tint="@color/navy_400" />
                    </LinearLayout>

                    <!-- Inline Error Message -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/status_danger_main"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Tên đăng nhập hoặc mật khẩu không chính xác." />

                    <!-- Login CTA Button -->
                    <FrameLayout
                        android:id="@+id/btnLoginContainer"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/btn_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBtnLoginText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Đăng nhập"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/loadingLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progressBar"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:indeterminateTint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Đang xác thực..."
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/successLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_check_circle_green"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvSuccessText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Đăng nhập thành công!"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- 3. Bottom Security / Driver Info Pill Card (Centered at Bottom) -->
            <LinearLayout
                android:id="@+id/bottomInfoCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_bottom_info_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Security badge"
                        android:src="@drawable/ic_shield_check" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ứng dụng dành cho tài xế thu gom rác"
                            android:textColor="@color/navy_950"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Smart Waste Management System"
                            android:textColor="@color/navy_500"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>
