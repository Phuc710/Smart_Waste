<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/jobsSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/jobsNestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/jobsRootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_padding">

            <!-- 1. Shared Unified AppHeader with Settings Gear Icon on Top Right -->
            <com.example.app_smart_waste.ui.common.AppHeaderView
                android:id="@+id/appHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_horizontal_padding">

                <!-- 2. WORK AVAILABILITY CARD (Grab-Style On/Off) -->
                <LinearLayout
                    android:id="@+id/cardWorkAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_availability_on"
                    android:elevation="0.5dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trạng thái làm việc"
                                android:textColor="@color/profile_text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAvailabilityStatusLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="🟢 Sẵn sàng nhận việc"
                                android:textColor="@color/profile_green_primary"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAvailability"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/profile_green_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAvailabilityDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Bạn đang sẵn sàng nhận nhiệm vụ tự chọn."
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 3. WORK SHIFT CARD (Dynamically Calculated: ON + 8 Hours) -->
                <LinearLayout
                    android:id="@+id/cardShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_profile"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvShiftHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ca làm việc"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeShiftActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_role_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="🟢 Đang trong ca"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Shift Time Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvShiftNameLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ca trực 8 tiếng"
                                android:textColor="@color/profile_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvShiftTimeRange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="08:30 — 16:30"
                                android:textColor="@color/profile_text_secondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/profile_divider" />

                        <!-- Assigned Vehicle Info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Xe phụ trách"
                                android:textColor="@color/profile_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="51C-234.56 (8m³)"
                                android:textColor="@color/profile_text_secondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. PRIMARY TOP SEGMENTED CONTROL ( [ Đang xử lý (🔴 2) ]  [ Lịch sử ] ) -->
                <LinearLayout
                    android:id="@+id/layoutJobsSegmentedControl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_dialog_item_field"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <!-- Tab 1: Đang xử lý -->
                    <LinearLayout
                        android:id="@+id/tabActiveJobs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_profile"
                        android:clickable="true"
                        android:elevation="0.5dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelTabActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang xử lý"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_role_badge_pill"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="2"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tab 2: Lịch sử -->
                    <LinearLayout
                        android:id="@+id/tabHistoryJobs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelTabHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lịch sử"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvHistoryTabCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_dialog_item_field"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="3"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 5. CONTAINER TAB 1: ĐANG XỬ LÝ                           -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/layoutActiveJobsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- SUB-FILTER CHIPS: [ Tất cả ]  [ 🕒 Đang chờ ]  [ ▶️ Đang làm ] -->
                    <LinearLayout
                        android:id="@+id/layoutActiveSubFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <!-- Chip: Tất cả -->
                        <TextView
                            android:id="@+id/chipActiveSubAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_filter_active"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Tất cả"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <!-- Chip: 🕒 Đang chờ (3) -->
                        <TextView
                            android:id="@+id/chipActiveSubPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="🕒 Đang chờ (3)"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />

                        <!-- Chip: ▶️ Đang làm (2) -->
                        <TextView
                            android:id="@+id/chipActiveSubInProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="▶️ Đang làm (2)"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Active Jobs RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvActiveJobsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_job_assigned_card" />

                    <!-- Empty Active Jobs State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyActiveJobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card_profile"
                        android:elevation="0.5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Bản đồ"
                            android:src="@drawable/ic_nav_map"
                            app:tint="@color/profile_green_primary" />

                        <TextView
                            android:id="@+id/tvEmptyActiveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Chưa có nhiệm vụ"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyActiveSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Hiện chưa có ca thu gom cần xử lý."
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnOpenMapFromActiveEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_btn_primary_green"
                            android:paddingHorizontal="24dp"
                            android:text="Mở bản đồ"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 6. CONTAINER TAB 2: LỊCH SỬ (Matching Image 1 & 2)       -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/layoutHistoryJobsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Filter Chips Row: [ Tất cả ] [ Hoàn thành ] [ Đã hủy ] -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_filter_active"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Tất cả"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Hoàn thành"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chipFilterCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Đã hủy"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- History RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHistoryJobsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_job_history_card" />

                    <!-- Empty History State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyHistoryJobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card_profile"
                        android:elevation="0.5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Trống"
                            android:src="@drawable/ic_check_circle_green"
                            app:tint="@color/profile_text_tertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Chưa có lịch sử thu gom"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Các ca kết thúc sẽ hiển thị tại đây."
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
