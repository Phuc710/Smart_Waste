<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/jobsSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/jobsNestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:id="@+id/jobsRootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/screen_bottom_padding">

            <!-- 1. Shared Unified AppHeader with Settings Gear Icon on Top Right -->
            <com.example.app_smart_waste.ui.common.AppHeaderView
                android:id="@+id/appHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_horizontal_padding">

                <!-- 2. WORK AVAILABILITY CARD (Modern Clean Material 3 Card) -->
                <LinearLayout
                    android:id="@+id/cardWorkAvailability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_availability_on"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="TRẠNG THÁI LÀM VIỆC"
                                android:textColor="@color/navy_500"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/dotAvailabilityIndicator"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_dot_active_green" />

                                <TextView
                                    android:id="@+id/tvAvailabilityStatusLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Sẵn sàng nhận việc"
                                    android:textColor="@color/profile_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAvailability"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAvailabilityDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Hệ thống tự động điều phối nhiệm vụ thu gom tối ưu về xe của bạn."
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 3. PRIMARY TOP SEGMENTED CONTROL ( [ Đang xử lý (🔴 2) ]  [ Lịch sử ] ) -->
                <LinearLayout
                    android:id="@+id/layoutJobsSegmentedControl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_dialog_item_field"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <!-- Tab 1: Đang xử lý (Active default) -->
                    <LinearLayout
                        android:id="@+id/tabActiveJobs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_tab_active"
                        android:clickable="true"
                        android:elevation="1dp"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelTabActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang xử lý"
                            android:textColor="@color/white"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveCountBadge"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_on_active_tab"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tab 2: Lịch sử (Inactive default) -->
                    <LinearLayout
                        android:id="@+id/tabHistoryJobs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLabelTabHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lịch sử"
                            android:textColor="@color/app_text_primary"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvHistoryTabCountBadge"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_on_inactive_tab"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/app_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 5. CONTAINER TAB 1: ĐANG XỬ LÝ                           -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/layoutActiveJobsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- SUB-FILTER CHIPS: [ Tất cả ]  [ 🕒 Đang chờ ]  [ ▶️ Đang làm ] -->
                    <LinearLayout
                        android:id="@+id/layoutActiveSubFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <!-- Chip: Tất cả -->
                        <TextView
                            android:id="@+id/chipActiveSubAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_filter_active"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Tất cả"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <!-- Chip:  Đang chờ-->
                        <TextView
                            android:id="@+id/chipActiveSubPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Đang chờ"
                            android:textColor="@color/app_text_primary"
                            android:textSize="12.5sp" />

                        <!-- Chip:  Đang làm (2) -->
                        <TextView
                            android:id="@+id/chipActiveSubInProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Đang làm"
                            android:textColor="@color/app_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Active Jobs RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvActiveJobsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_job_assigned_card" />

                    <!-- Empty Active Jobs State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyActiveJobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card_profile"
                        android:elevation="0.5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Bản đồ"
                            android:src="@drawable/ic_nav_map"
                            app:tint="@color/profile_green_primary" />

                        <TextView
                            android:id="@+id/tvEmptyActiveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Chưa có nhiệm vụ"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyActiveSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Hiện chưa có ca thu gom cần xử lý."
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnOpenMapFromActiveEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_btn_primary_green"
                            android:paddingHorizontal="24dp"
                            android:text="Mở bản đồ"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ========================================================= -->
                <!-- 6. CONTAINER TAB 2: LỊCH SỬ (Matching Image 1 & 2)       -->
                <!-- ========================================================= -->
                <LinearLayout
                    android:id="@+id/layoutHistoryJobsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Filter Chips Row: [ Tất cả ] [ Hoàn thành ] [ Đã hủy ] -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_filter_active"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Tất cả"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Hoàn thành"
                            android:textColor="@color/app_text_primary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chipFilterCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_filter_inactive"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Đã hủy"
                            android:textColor="@color/app_text_primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- History RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHistoryJobsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_job_history_card" />

                    <!-- Empty History State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyHistoryJobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card_profile"
                        android:elevation="0.5dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Trống"
                            android:src="@drawable/ic_check_circle_green"
                            app:tint="@color/profile_text_tertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Chưa có lịch sử thu gom"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Các ca kết thúc sẽ hiển thị tại đây."
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- CENTERED LOADING OVERLAY (Hiển thị ngay giữa màn hình điện thoại) -->
    <LinearLayout
        android:id="@+id/layoutLoadingCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_profile"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbLoadingJobs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/profile_green_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Đang tải dữ liệu ca làm..."
            android:textColor="@color/profile_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
