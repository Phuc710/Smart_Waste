<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- 1. Shared Unified AppHeader -->
    <com.example.app_smart_waste.ui.common.AppHeaderView
        android:id="@+id/execAppHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llExecContentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_padding"
            android:paddingBottom="40dp">

            <!-- 2. Tiến độ ca thu gom Card -->
            <LinearLayout
                android:id="@+id/cardExecProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_profile"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tiến độ ca thu gom"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btnExecPauseJob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_pause_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:id="@+id/ivExecPauseIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Tạm dừng"
                            android:src="@drawable/ic_pause_orange" />

                        <TextView
                            android:id="@+id/tvExecPauseLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Tạm dừng ca"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExecStopsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2 / 3 điểm"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExecPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="67%"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbExecProgress"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="67"
                    android:progressDrawable="@drawable/bg_bin_percent_green" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvExecSummaryText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đã hoàn thành 2 điểm thu gom"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvExecRemainingKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn 1.2 km"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. ĐIỂM HIỆN TẠI Card (Highlight Card) -->
            <LinearLayout
                android:id="@+id/cardExecCurrentBin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_current_bin"
                android:elevation="1.5dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ĐIỂM HIỆN TẠI"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExecStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_role_badge_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Đang thu gom"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExecCurrentBinId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="BIN_HCM_04"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExecCurrentBinAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Phố đi bộ Nguyễn Huệ, Q1"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="13sp" />

                <!-- Waste Level Indicator Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_notif_red">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Mức rác"
                            android:src="@drawable/ic_trash_bin_red"
                            app:tint="@color/profile_danger" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvExecCurrentLevelPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="92%"
                                android:textColor="@color/profile_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Mức rác"
                                android:textColor="@color/profile_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbExecCurrentLevel"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="92"
                            android:progressDrawable="@drawable/bg_bin_percent_red" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2 Action Buttons: Dẫn đường & Mở nắp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExecNavigate"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary_gray"
                        android:drawableStart="@drawable/ic_navigation_arrow"
                        android:drawableTint="@color/profile_green_primary"
                        android:paddingHorizontal="14dp"
                        android:text="Dẫn đường"
                        android:textAllCaps="false"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnExecUnlockLid"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_secondary_gray"
                        android:drawableStart="@drawable/ic_lock_open_green"
                        android:drawableTint="@color/profile_green_primary"
                        android:paddingHorizontal="14dp"
                        android:text="Mở nắp"
                        android:textAllCaps="false"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Big Main Action: Xác nhận đã thu gom -->
                <Button
                    android:id="@+id/btnExecConfirmCollect"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_primary_green"
                    android:drawableStart="@drawable/ic_camera_white"
                    android:paddingHorizontal="20dp"
                    android:text="Xác nhận đã thu gom"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Sub action: Báo sự cố / Bỏ qua điểm -->
                <LinearLayout
                    android:id="@+id/btnExecReportIncident"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Báo sự cố"
                        android:src="@drawable/ic_warning_triangle"
                        app:tint="@color/profile_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Báo sự cố / Bỏ qua điểm"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 4. Các điểm tiếp theo Card -->
            <LinearLayout
                android:id="@+id/cardExecUpcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_profile"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Các điểm tiếp theo"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Next Stop Item: BIN_HCM_07 -->
                <LinearLayout
                    android:id="@+id/itemExecNextStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dialog_item_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_work_info">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="03"
                            android:textColor="@color/profile_green_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIN_HCM_07"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Cột cờ Thủ Ngữ, Q1"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_role_badge_pill"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="78% Gần đầy"
                            android:textColor="#D97706"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="📍 1.3 km"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Xem"
                        android:src="@drawable/ic_chevron_right_gray" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
