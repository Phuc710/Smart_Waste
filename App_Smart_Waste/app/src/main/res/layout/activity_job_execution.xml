<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Top floating notification banner container -->
    <FrameLayout
        android:id="@+id/containerTopNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:elevation="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Unified AppHeader -->
        <com.example.app_smart_waste.ui.common.AppHeaderView
            android:id="@+id/appHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Main Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="24dp">

                <!-- 2. Section: Tiến độ thu gom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tiến độ thu gom"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExecProgressFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/profile_green_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        tools:text="3/5 điểm" />
                </LinearLayout>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbExecProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="60"
                    android:progressDrawable="@drawable/bg_bin_percent_green" />

                <!-- 3. Section: Điểm dừng hiện tại -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Điểm dừng hiện tại"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- Current Stop Card -->
                <LinearLayout
                    android:id="@+id/cardExecCurrentStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_current_stop_card"
                    android:elevation="1dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Bin Illustration -->
                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="68dp"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_dialog_item_field">

                        <ImageView
                            android:id="@+id/ivCurrentBinImage"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/profile_green_primary" />
                    </LinearLayout>

                    <!-- Bin Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCurrentBinId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            tools:text="BIN_HCM_003" />

                        <TextView
                            android:id="@+id/tvCurrentBinAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12.5sp"
                            tools:text="78 Cách Mạng Tháng 8, Q.3" />

                        <TextView
                            android:id="@+id/tvCurrentBinFillLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/profile_text_primary"
                            android:textSize="12.5sp"
                            tools:text="Mức đầy: 72%" />

                        <TextView
                            android:id="@+id/tvCurrentBinType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp"
                            tools:text="Loại thùng: Thùng 240L" />

                        <TextView
                            android:id="@+id/tvCurrentBinNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp"
                            tools:text="Ghi chú: Thùng đặt gần cột điện." />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. Row: 3 Action Buttons [ Chỉ đường ] [ Mở nắp ] [ Báo sự cố ] -->
                <LinearLayout
                    android:id="@+id/layoutExecActionsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- 1. Chỉ đường -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecDirections"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Chỉ đường"
                        android:textAllCaps="false"
                        android:textColor="#2563EB"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_navigation_arrow"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="17dp"
                        app:iconTint="#2563EB"
                        app:strokeColor="#DBEAFE"
                        app:strokeWidth="1dp" />

                    <!-- 2. Mở nắp -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecOpenLid"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Mở nắp"
                        android:textAllCaps="false"
                        android:textColor="#2563EB"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_trash_open_lid"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="17dp"
                        app:iconTint="#2563EB"
                        app:strokeColor="#DBEAFE"
                        app:strokeWidth="1dp" />

                    <!-- 3. Báo sự cố -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExecReportIncident"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Báo sự cố"
                        android:textAllCaps="false"
                        android:textColor="#DC2626"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_warning_triangle"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="17dp"
                        app:iconTint="#DC2626"
                        app:strokeColor="#FEE2E2"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- 5. Primary Action Button: [ ✓ Xác nhận đã thu gom ] -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExecConfirmCollected"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/profile_green_primary"
                    android:elevation="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="Xác nhận đã thu gom"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <!-- 6. Section: Các điểm dừng tiếp theo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Các điểm dừng tiếp theo"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- Next Stops Container -->
                <LinearLayout
                    android:id="@+id/llExecNextStopsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</RelativeLayout>
