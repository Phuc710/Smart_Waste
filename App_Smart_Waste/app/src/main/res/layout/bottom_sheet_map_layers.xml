<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Header: Lớp bản đồ + Close icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Lớp bản đồ"
                android:textColor="#0F172A"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseLayersSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="4dp"
                android:src="@drawable/ic_close_gray" />
        </RelativeLayout>

        <!-- 1. Mặc định (Default Layer) -->
        <LinearLayout
            android:id="@+id/btnLayerDefault"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRadioDefault"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_green"
                app:tint="#16A34A" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Mặc định"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Hidden for code interop -->
            <ImageView
                android:id="@+id/ivCheckDefault"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2. Vệ tinh (Satellite Layer) -->
        <LinearLayout
            android:id="@+id/btnLayerSatellite"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRadioSatellite"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_outline"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Vệ tinh"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Hidden for code interop -->
            <ImageView
                android:id="@+id/ivCheckSatellite"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Địa hình (Terrain Layer) -->
        <LinearLayout
            android:id="@+id/btnLayerTerrain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRadioTerrain"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_outline"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Địa hình"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Hidden for code interop -->
            <ImageView
                android:id="@+id/ivCheckTerrain"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Close Button: [ Đóng ] -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCloseLayersButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_outlined_gray"
            android:text="Đóng"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>
</LinearLayout>
