<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <!-- Header: Bộ lọc thùng rác + Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Bộ lọc thùng rác"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseFilterSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng bộ lọc"
                android:padding="6dp"
                android:src="@drawable/ic_close_gray" />
        </RelativeLayout>

        <!-- Checkbox Filter Rows (Matching Sheet A Mockup) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- 1. Critical (> 85%) -->
            <LinearLayout
                android:id="@+id/layoutRowCritical"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_soft_red">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_trash"
                        app:tint="#DC2626" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Critical ( > 85% )"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbFilterCritical"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:button="@null"
                    android:background="@drawable/selector_filter_checkbox"
                    android:checked="true" />
            </LinearLayout>

            <!-- 2. Warning (60% - 85%) -->
            <LinearLayout
                android:id="@+id/layoutRowWarning"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_soft_orange">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_trash"
                        app:tint="#EA580C" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Warning ( 60% - 85% )"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbFilterWarning"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:button="@null"
                    android:background="@drawable/selector_filter_checkbox"
                    android:checked="true" />
            </LinearLayout>

            <!-- 3. Normal (< 60%) -->
            <LinearLayout
                android:id="@+id/layoutRowNormal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_soft_green">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_trash_green"
                        app:tint="#16A34A" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Normal ( &lt; 60% )"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbFilterNormal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:button="@null"
                    android:background="@drawable/selector_filter_checkbox"
                    android:checked="true" />
            </LinearLayout>

            <!-- 4. Offline -->
            <LinearLayout
                android:id="@+id/layoutRowOffline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_soft_gray">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stat_trash"
                        app:tint="#64748B" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Offline"
                    android:textColor="#64748B"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbFilterOffline"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:button="@null"
                    android:background="@drawable/selector_filter_checkbox"
                    android:checked="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACTION BUTTONS: [ Đặt lại ] | [ Áp dụng ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetFilter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outlined_gray"
                android:text="Đặt lại"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_primary_green"
                android:text="Áp dụng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
