<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#CBD5E1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tạm dừng ca thu gom"
        android:textColor="@color/profile_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Vui lòng chọn hoặc nhập lý do tạm dừng tuyến"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12.5sp" />

    <RadioGroup
        android:id="@+id/rgPauseReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <RadioButton
            android:id="@+id/rbPauseTraffic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:paddingVertical="8dp"
            android:text="Kẹt xe đường Nam Kỳ Khởi Nghĩa"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbPauseLunch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Nghỉ trưa / Tiếp nhiên liệu (30 phút)"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbPauseVehicleFault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Xe thu gom gặp sự cố kỹ thuật"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbPauseOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="Lý do khác..."
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary_gray"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnConfirmPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_btn_accept_green"
            android:backgroundTint="#F59E0B"
            android:text="Tạm dừng ca"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
