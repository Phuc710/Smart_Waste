<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJobInProgressRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_profile"
    android:clickable="true"
    android:elevation="1.5dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Badge Row: 🟢 ĐANG THỰC HIỆN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_dang_thuc_hien"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot_active_green"
                android:backgroundTint="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="ĐANG THỰC HIỆN"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvInProgressPercentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/profile_green_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="67%" />
    </LinearLayout>

    <!-- Job ID -->
    <TextView
        android:id="@+id/tvInProgressJobCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/profile_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="#JOB_1723801234" />

    <!-- Progress Summary -->
    <TextView
        android:id="@+id/tvInProgressPointsSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp"
        tools:text="2 / 3 điểm đã hoàn thành" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbInProgressCard"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_bin_percent_green" />

    <!-- Current Target Point info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_item_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Điểm hiện tại"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/profile_green_primary" />

        <TextView
            android:id="@+id/tvInProgressCurrentBin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/profile_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Điểm hiện tại: BIN-001" />
    </LinearLayout>

    <!-- Action Button: [ Tiếp tục ca ] -->
    <Button
        android:id="@+id/btnContinueExecution"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_primary_green"
        android:drawableStart="@drawable/ic_play_white"
        android:paddingHorizontal="20dp"
        android:text="Tiếp tục thu gom"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
