<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface"
    android:gravity="center_vertical"
    android:minHeight="@dimen/header_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/header_horizontal_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 1. Optional Navigation Icon / Hamburger Button -->
    <FrameLayout
        android:id="@+id/btnHeaderNav"
        android:layout_width="@dimen/header_icon_button_size"
        android:layout_height="@dimen/header_icon_button_size"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivHeaderNavIcon"
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:layout_gravity="center"
            android:contentDescription="Navigation"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@color/app_text_primary" />
    </FrameLayout>

    <!-- 2. Standardized Page Title & Optional Subtitle (Identical Baseline Across All Screens) -->
    <LinearLayout
        android:id="@+id/llHeaderTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Page Title"
            android:textColor="@color/app_text_primary"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Subtitle"
            android:textColor="@color/app_text_secondary"
            android:textSize="@dimen/header_subtitle_size"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Standardized Action Buttons Container (Refresh, Settings, Bell, Filter) -->
    <LinearLayout
        android:id="@+id/llHeaderActionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Secondary Action Button (e.g. Filter, Read All) -->
        <FrameLayout
            android:id="@+id/btnHeaderActionSecondary"
            android:layout_width="@dimen/header_icon_button_size"
            android:layout_height="@dimen/header_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivHeaderActionSecondaryIcon"
                android:layout_width="@dimen/header_icon_size"
                android:layout_height="@dimen/header_icon_size"
                android:layout_gravity="center"
                android:contentDescription="Secondary Action"
                android:src="@drawable/ic_chevron_right_gray"
                app:tint="@color/app_text_primary" />
        </FrameLayout>

        <!-- Primary Action Button (e.g. Refresh, Settings, Bell) -->
        <FrameLayout
            android:id="@+id/btnHeaderAction"
            android:layout_width="@dimen/header_icon_button_size"
            android:layout_height="@dimen/header_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivHeaderActionIcon"
                android:layout_width="@dimen/header_icon_size"
                android:layout_height="@dimen/header_icon_size"
                android:layout_gravity="center"
                android:contentDescription="Action"
                android:src="@drawable/ic_refresh_gray"
                app:tint="@color/app_text_primary" />

            <!-- Red Notification / Alert Badge with White Border -->
            <TextView
                android:id="@+id/tvHeaderActionBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                android:background="@drawable/bg_badge_count_red"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="4dp"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
