<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_profile"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row: Bin ID + Name + Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_notif_green">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Thùng rác"
                android:src="@drawable/ic_trash_bin_red"
                app:tint="@color/profile_green_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBinPreviewId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIN_HCM_04"
                android:textColor="@color/profile_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBinPreviewName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Thùng rác Landmark 81"
                android:textColor="@color/profile_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBinPreviewLevelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="88% Đầy"
            android:textColor="#D97706"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/profile_menu_divider" />

    <!-- 1. Vị trí & Địa chỉ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:contentDescription="Vị trí"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/profile_text_secondary" />

        <TextView
            android:id="@+id/tvBinPreviewAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="Công viên Central Park, Vinhomes Central Park, Bình Thạnh"
            android:textColor="@color/profile_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 2. Tọa độ GPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Tọa độ"
            android:src="@drawable/ic_nav_map"
            app:tint="@color/profile_text_secondary" />

        <TextView
            android:id="@+id/tvBinPreviewCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Tọa độ: 10.7950, 106.7219"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3. Mức rác & Trạng thái nắp & Last Seen Info Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_item_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái nắp"
                android:textColor="@color/profile_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBinPreviewLidStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Đang mở"
                android:textColor="@color/profile_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="@color/profile_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cập nhật gần nhất"
                android:textColor="@color/profile_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBinPreviewLastSeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="22:38:53"
                android:textColor="@color/profile_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
