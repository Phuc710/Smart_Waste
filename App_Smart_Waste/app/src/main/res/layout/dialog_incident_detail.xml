<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_profile"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Code & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialogIncidentCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#INC_102"
            android:textColor="@color/profile_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogIncidentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill_red"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="MỚI TIẾP NHẬN"
            android:textColor="#DC2626"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#F1F5F9" />

    <!-- Field 1: Thùng rác -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Điểm thùng rác:"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDialogIncidentBin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="BIN_HCM_02 - Phố Đi Bộ Nguyễn Huệ"
        android:textColor="@color/profile_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Field 2: Loại sự cố -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Loại sự cố:"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDialogIncidentReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Rác quá đầy tràn ra ngoài"
        android:textColor="#D97706"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Field 3: Mô tả chi tiết -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mô tả chi tiết:"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDialogIncidentDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:text="Thùng rác phố đi bộ quá tải vào giờ cao điểm, rác tràn nắp..."
        android:textColor="@color/profile_text_primary"
        android:textSize="13sp" />

    <!-- Field 4: Thời gian gửi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Thời gian gửi:"
        android:textColor="@color/profile_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDialogIncidentTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="14:32 • 17/08/2026"
        android:textColor="@color/profile_text_tertiary"
        android:textSize="12.5sp" />

    <!-- Field 5: Ảnh minh chứng hiện trường -->
    <LinearLayout
        android:id="@+id/layoutDialogIncidentPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh minh chứng hiện trường:"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_clean">

            <ImageView
                android:id="@+id/ivDialogIncidentPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Ảnh hiện trường"
                android:scaleType="centerCrop" />

            <ProgressBar
                android:id="@+id/pbDialogPhotoLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/profile_green_primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Button Close -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDialogCloseIncident"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_primary_green"
        android:text="Đóng"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
