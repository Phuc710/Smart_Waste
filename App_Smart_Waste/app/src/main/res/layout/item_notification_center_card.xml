<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotificationItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_notification_center_card"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- 1. Left Round Icon Container -->
    <FrameLayout
        android:id="@+id/containerCenterNotifIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_banner_icon_green">

        <ImageView
            android:id="@+id/ivCenterNotifIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_banner_clipboard_green" />
    </FrameLayout>

    <!-- 2. Middle Content: Title & Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title Row with optional Unread Dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewCenterNotifDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot_active_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCenterNotifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Nhiệm vụ mới #JOB-0258" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvCenterNotifSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#475569"
            android:textSize="12.5sp"
            tools:text="Bạn được giao tuyến thu gom 3 thùng rác." />
    </LinearLayout>

    <!-- 3. Right Timestamp -->
    <TextView
        android:id="@+id/tvCenterNotifTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        tools:text="10:30" />

</LinearLayout>
