<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#CBD5E1" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cài đặt GPS &amp; Âm báo"
            android:textColor="@color/profile_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseGpsSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_gray" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tùy chỉnh chu kỳ phát tọa độ GPS và âm thanh điều phối"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp" />

    <!-- GPS Frequency Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tần suất phát tín hiệu GPS"
        android:textColor="@color/profile_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgGpsInterval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_item_field"
        android:padding="10dp">

        <RadioButton
            android:id="@+id/rbGps5s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/profile_green_primary"
            android:text="5 giây (Thời gian thực / Độ chính xác cao)"
            android:textColor="@color/profile_text_primary"
            android:textSize="13.5sp" />

        <RadioButton
            android:id="@+id/rbGps10s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/profile_green_primary"
            android:checked="true"
            android:text="10 giây (Khuyên dùng / Cân bằng pin &amp; vị trí)"
            android:textColor="@color/profile_text_primary"
            android:textSize="13.5sp" />

        <RadioButton
            android:id="@+id/rbGps30s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/profile_green_primary"
            android:text="30 giây (Tiết kiệm pin)"
            android:textColor="@color/profile_text_primary"
            android:textSize="13.5sp" />

        <RadioButton
            android:id="@+id/rbGps60s"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/profile_green_primary"
            android:text="60 giây (Chế độ chờ / Tiết kiệm tối đa)"
            android:textColor="@color/profile_text_primary"
            android:textSize="13.5sp" />
    </RadioGroup>

    <!-- Notification Switches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Job sound -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_dialog_item_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chuông báo khi có Job mới"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Phát chuông âm lượng lớn khi điều phối lệnh"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchJobSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/profile_green_primary"
                app:trackTint="@color/profile_green_light" />
        </LinearLayout>

        <!-- Overload bin alert -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_item_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Âm thanh cảnh báo thùng đầy (>85%)"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Cảnh báo khi điểm gần nhất cần ưu tiên"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBinAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/profile_green_primary"
                app:trackTint="@color/profile_green_light" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveGpsSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_primary_green"
        android:text="Lưu cấu hình"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
