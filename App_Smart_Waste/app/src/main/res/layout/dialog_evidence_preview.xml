<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_map"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle_gray" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Ảnh minh chứng thu gom"
        android:textColor="@color/profile_text_primary"
        android:textSize="16.5sp"
        android:textStyle="bold" />

    <!-- Image Preview Frame -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/ivEvidencePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh minh chứng"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_bottom_sheet_map" />
    </androidx.cardview.widget.CardView>

    <!-- Counter Indicator -->
    <TextView
        android:id="@+id/tvEvidenceCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="1/1"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp" />

    <!-- Close Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCloseEvidencePreview"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_button_primary_green"
        android:text="Đóng"
        android:textColor="@color/white"
        android:textSize="14.5sp"
        android:textStyle="bold" />

</LinearLayout>
