<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_profile"
    android:elevation="0.5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="8dp">

    <!-- Numbered Circle -->
    <FrameLayout
        android:id="@+id/containerNextStopNumber"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_avatar_circle_green">

        <TextView
            android:id="@+id/tvNextStopNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="4" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNextStopBinId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="BIN_HCM_004" />

        <TextView
            android:id="@+id/tvNextStopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12sp"
            tools:text="210 Điện Biên Phủ, Q.3" />
    </LinearLayout>

    <!-- Distance Column -->
    <TextView
        android:id="@+id/tvNextStopDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="0.9 km" />

</LinearLayout>
