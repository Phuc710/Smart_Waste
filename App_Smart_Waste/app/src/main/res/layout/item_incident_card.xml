<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dialog_item_field"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Card Header: Device + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIncidentBinName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thùng rác #BIN-002"
            android:textColor="@color/profile_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIncidentStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="ĐANG KIỂM TRA"
            android:textColor="@color/profile_green_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Reason -->
    <TextView
        android:id="@+id/tvIncidentReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nắp kẹt không mở được"
        android:textColor="@color/profile_green_dark"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvIncidentDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Nắp thùng bị kẹt cơ học do vật lạ chặn khe cảm biến."
        android:textColor="@color/profile_text_secondary"
        android:textSize="12.5sp" />

    <!-- Location & Timestamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIncidentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 Nhà thờ Đức Bà, Quận 1"
            android:textColor="@color/profile_text_tertiary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvIncidentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hôm nay, 08:15"
            android:textColor="@color/profile_text_tertiary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Photo Signed URL Action Button (If photo attached) -->
    <LinearLayout
        android:id="@+id/btnViewIncidentPhoto"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_role_badge_pill"
        android:backgroundTint="#EFF6FF"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Ảnh"
            android:src="@drawable/ic_image_photo"
            app:tint="#1976D2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Xem ảnh minh chứng (Signed URL)"
            android:textColor="#1976D2"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
